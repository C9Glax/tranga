{
  "openapi": "3.1.1",
  "info": {
    "title": "Services.Libraries | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/libraries": {
      "get": {
        "tags": [
          "Libraries"
        ],
        "summary": "List of all configured library extensions",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Library"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/libraries/komga": {
      "put": {
        "tags": [
          "Libraries"
        ],
        "summary": "Add komga library extension",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddKomgaLibraryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/libraries/komga/test-connection": {
      "post": {
        "tags": [
          "Libraries"
        ],
        "summary": "Validate Komga credentials without persisting anything",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TestKomgaConnectionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/libraries/{libraryId}": {
      "delete": {
        "tags": [
          "Libraries"
        ],
        "summary": "Remove a library extension",
        "parameters": [
          {
            "name": "libraryId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "patch": {
        "tags": [
          "Libraries"
        ],
        "summary": "Rename a library extension and/or rotate its credentials",
        "parameters": [
          {
            "name": "libraryId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchLibraryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/libraries/{libraryId}/link": {
      "post": {
        "tags": [
          "Libraries"
        ],
        "summary": "Manually link unmapped Manga to the library's series by name",
        "parameters": [
          {
            "name": "libraryId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "pattern": "^-?(?:0|[1-9]\\d*)$",
                  "type": [
                    "integer",
                    "string"
                  ],
                  "format": "int32"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/libraries/mappings/{mangaId}": {
      "get": {
        "tags": [
          "Libraries"
        ],
        "summary": "Get the library-extension links for a Manga",
        "parameters": [
          {
            "name": "mangaId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LibraryMangaLink"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/libraries/gitinfo": {
      "get": {
        "tags": [
          "GitInfo"
        ],
        "summary": "Build commit/version/branch info for this service",
        "operationId": "GetGitInfo",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GitInfoResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddKomgaLibraryRequest": {
        "required": [
          "name",
          "baseUrl"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "baseUrl": {
            "type": "string"
          },
          "apiKey": {
            "type": [
              "null",
              "string"
            ]
          },
          "username": {
            "type": [
              "null",
              "string"
            ]
          },
          "password": {
            "type": [
              "null",
              "string"
            ]
          },
          "libraryRootPath": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "GitInfoResponse": {
        "required": [
          "sha",
          "commit",
          "branch",
          "version",
          "commitDate",
          "isDirty"
        ],
        "type": "object",
        "properties": {
          "sha": {
            "type": "string",
            "description": "Full git commit SHA."
          },
          "commit": {
            "type": "string",
            "description": "Short (8-character) git commit SHA."
          },
          "branch": {
            "type": "string",
            "description": "Git branch the build was produced from."
          },
          "version": {
            "type": "string",
            "description": "SemVer derived from the nearest git tag and commit count."
          },
          "commitDate": {
            "type": "string",
            "description": "Timestamp of the commit the build was produced from."
          },
          "isDirty": {
            "type": "boolean",
            "description": "Whether the working tree had uncommitted changes at build time."
          }
        },
        "description": "Build commit/version/branch info for this service, sourced from devlooped/GitInfo at build time."
      },
      "Library": {
        "required": [
          "libraryServiceType",
          "id",
          "name",
          "baseUrl"
        ],
        "type": "object",
        "properties": {
          "libraryServiceType": {
            "$ref": "#/components/schemas/LibraryServiceType"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "baseUrl": {
            "type": "string"
          }
        }
      },
      "LibraryMangaLink": {
        "required": [
          "libraryServiceId",
          "seriesUrl"
        ],
        "type": "object",
        "properties": {
          "libraryServiceId": {
            "type": "string",
            "format": "uuid"
          },
          "seriesUrl": {
            "type": "string"
          }
        }
      },
      "LibraryServiceType": {
        "enum": [
          "Komga"
        ]
      },
      "PatchLibraryRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "apiKey": {
            "type": [
              "null",
              "string"
            ]
          },
          "username": {
            "type": [
              "null",
              "string"
            ]
          },
          "password": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "TestKomgaConnectionRequest": {
        "required": [
          "baseUrl"
        ],
        "type": "object",
        "properties": {
          "baseUrl": {
            "type": "string"
          },
          "apiKey": {
            "type": [
              "null",
              "string"
            ]
          },
          "username": {
            "type": [
              "null",
              "string"
            ]
          },
          "password": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Libraries"
    },
    {
      "name": "GitInfo"
    }
  ]
}