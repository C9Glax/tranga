            "description": "Display name of the extension."
          },
          "lang": {
            "type": "string",
            "description": "Tachiyomi language code, e.g. `en`, `pt-BR`, `all`."
          },
          "iconUrl": {
            "type": "string",
            "description": "Gateway-relative url of the extension's icon."
          },
          "versionName": {
            "type": "string",
            "description": "Version currently installed, or offered by the store when not installed."
          },
          "contentWarning": {
            "description": "How the extension store classifies the content. A `Mixed` extension stays usable while `AllowNSFW` is off; only `Nsfw` ones are held back.",
            "$ref": "#/components/schemas/SuwayomiContentWarning"
          },
          "isInstalled": {
            "type": "boolean",
            "description": "Whether the extension is installed on the sidecar."
          },
          "isObsolete": {
            "type": "boolean",
            "description": "Whether the extension is no longer offered by any configured store."
          },
          "hasUpdate": {
            "type": "boolean",
            "description": "Whether a newer version is available."
          }
