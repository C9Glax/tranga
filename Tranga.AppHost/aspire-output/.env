# Parameter AllowNSFW
ALLOWNSFW=false

# Parameter AuthSigningKey
AUTHSIGNINGKEY=

# Parameter DownloadLanguage
DOWNLOADLANGUAGE=en

# Parameter FlaresolverrUrl
FLARESOLVERRURL=

# Container image name for frontend
FRONTEND_IMAGE=

MangaDirectory="Manga"

# User/Group ID that owns files written to MangaDirectory (default: 1000)
PUID=1000
PGID=1000

POSTGRESPASSWORD="postgres"

POSTGRESUSER="postgres"

RABBITMQPASSWORD="tranga"

RABBITMQUSER="tranga"

# Container image name for services-auth
SERVICES_AUTH_IMAGE=

# Default container port for services-auth
SERVICES_AUTH_PORT=3005

# Container image name for services-libraries
SERVICES_LIBRARIES_IMAGE=

# Default container port for services-libraries
SERVICES_LIBRARIES_PORT=3004

# Container image name for services-manga
SERVICES_MANGA_IMAGE=

SERVICES_MANGA_PORT=3001

# Container image name for services-notifications
SERVICES_NOTIFICATIONS_IMAGE=

# Default container port for services-notifications
SERVICES_NOTIFICATIONS_PORT=3003

# Container image name for services-tasks
SERVICES_TASKS_IMAGE=

# Default container port for services-tasks
SERVICES_TASKS_PORT=3002

# Parameter UseAuth
USEAUTH=

