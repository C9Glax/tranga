# Parameter AllowNSFW
ALLOWNSFW=false

# Parameter UseAuth
USEAUTH=

# Parameter AuthSigningKey `openssl rand -base64 32`
AUTHSIGNINGKEY=

# Parameter DownloadLanguage
DOWNLOADLANGUAGE=en

# Parameter FlaresolverrUrl
FLARESOLVERRURL=

# Parameter MalClientId
MALCLIENTID=

# User/Group ID that owns files written to MangaDirectory (default: 1000)
PUID=1000
PGID=1000

POSTGRESPASSWORD="postgres"
POSTGRESUSER="postgres"

RABBITMQPASSWORD="tranga"
RABBITMQUSER="tranga"

MangaDirectory="Manga"