{
  "id": "00000000-0000-0000-0000-000000000000",
  "name": "Manga.uno (example)",
  "baseUrl": "https://manga.uno",
  "format": "json",
  "languages": ["en"],
  "useFlareSolverr": false,
  "requestsPerSecond": 2,
  "headers": {},
  "seriesUrlPattern": "^https://manga\\.uno/m/(?<slug>[^/?#]+)",
  "search": {
    "urlTemplate": "/api/search/advanced?page={page}&limit=24&title={query}",
    "itemSelector": "data",
    "title": { "selector": "english_title, title" },
    "url": { "selector": "slug", "regex": "^(.+)$", "replacement": "/m/$1" },
    "cover": { "selector": "cover", "regex": "^", "replacement": "https://xz7.fstr-cdn.com" }
  },
  "chapters": {
    "urlTemplate": "/api/manga/{slug}",
    "itemSelector": "chapters",
    "url": { "selector": "id", "regex": "^(.+)$", "replacement": "/r/{slug}/$1" },
    "number": { "selector": "chapter_number", "regex": "^(\\d+(?:\\.\\d*[1-9])?)" },
    "title": { "selector": "title" },
    "date": { "selector": "published_at, created_at" }
  },
  "images": {
    "urlPattern": "/r/[^/]+/(?<id>\\d+)",
    "urlTemplate": "/api/chapter/{id}",
    "imageSelector": "pages"
  }
}
