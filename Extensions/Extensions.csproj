<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Common\Common.csproj" />
      <ProjectReference Include="..\GeneratedExtensionClients\GeneratedExtensionClients.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Naprise" Version="0.1.1" />
      <PackageReference Include="AngleSharp.XPath" Version="2.0.10" />
      <PackageReference Include="Google.Protobuf" Version="3.36.2" />
      <PackageReference Include="Grpc.Tools" Version="2.85.0">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
    </ItemGroup>

    <ItemGroup>
      <!-- Message types for the MANGA Plus API -->
      <Protobuf Include="Extensions\MangaPlusApi\mangaplus.proto" GrpcServices="None" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="Extensions.Tests" />
    </ItemGroup>

    <ItemGroup>
      <!-- Example custom source definitions, see SelectorDownloaderJson -->
      <EmbeddedResource Include="Custom\Examples\*.json" LogicalName="Extensions.Custom.Examples.%(Filename)%(Extension)" />
    </ItemGroup>

</Project>
